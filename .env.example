# Supabase Configuration
# Replace these placeholders with your actual project details from supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google AI Studio / Gemini Configuration
# NOTE: The AI Coach does NOT read a Gemini key from the frontend. The key lives
# server-side in the Supabase Edge Function (`coach-chat`) as the GEMINI_API_KEY
# secret. Set it with the Supabase CLI, not in this file:
#   supabase secrets set GEMINI_API_KEY=your-google-ai-studio-api-key
# (Optional) override the model (defaults to gemini-2.0-flash):
#   supabase secrets set GEMINI_MODEL=gemini-2.0-flash
